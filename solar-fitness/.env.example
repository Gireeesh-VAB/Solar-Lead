# Copy to .env and fill in real values. Never commit .env.
# Secrets and connection strings only — tunable coefficients (utilisation
# factor, cache precision, etc.) live in packages/config-packs/*.yaml per
# CFG-01, not here.

DATABASE_URL=postgresql+psycopg://solarfit:solarfit@localhost:5432/solarfit
REDIS_URL=redis://localhost:6379/0

# API-06: dev-only escape hatch. Never enable outside local development.
ALLOW_HEADER_TENANT=true

GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=
WEATHER_API_KEY=
OPENAI_API_KEY=

OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
