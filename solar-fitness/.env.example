# Copy to .env and fill in real values. Never commit .env.
# Secrets and connection strings only — tunable coefficients (utilisation
# factor, cache precision, etc.) live in packages/config-packs/*.yaml per
# CFG-01, not here.

DATABASE_URL=postgresql+psycopg://solarfit:solarfit@localhost:5432/solarfit
REDIS_URL=redis://localhost:6379/0

GOOGLE_MAPS_API_KEY=
GOOGLE_SOLAR_API_KEY=
WEATHER_API_KEY=
OPENAI_API_KEY=

# USN OCR (USN-02/03) — service-account JSON path for Google Cloud
# Vision, separate from the API-key-style GOOGLE_*_API_KEY vars above.
GOOGLE_APPLICATION_CREDENTIALS_PATH=

OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
