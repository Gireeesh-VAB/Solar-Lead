# Copy to .env.local and fill in real values. Never commit .env.local.
# See ../README.md's "Frontend setup" section for what each of these does
# and, especially, how NEXT_PUBLIC_GOOGLE_MAPS_API_KEY relates to (and
# differs from) the backend's own GOOGLE_MAPS_API_KEY.

# Base URL of the backend API. Defaults to http://localhost:8000 (matching
# ../backend's `make run`) if left unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Client-side Google Maps JavaScript API key. Required — without it the
# map renders "Map unavailable" instead of the interactive satellite view,
# even when the backend's GOOGLE_MAPS_API_KEY (backend/.env) is set
# correctly, since the two are read independently. See
# components/map/MapView.tsx.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Canonical site URL used for the sitemap, robots.txt, and page metadata.
# Defaults to a placeholder example.com URL if left unset — leave this
# commented out rather than set-but-blank, since an empty (as opposed to
# absent) value is passed straight to `new URL()` and throws.
# NEXT_PUBLIC_SITE_URL=

# Local-dev-only login autofill (components/forms/LoginForm.tsx). Never
# set these in a staging/production env file — leaving them unset means
# the credential strings never appear in the client bundle at all.
NEXT_PUBLIC_DEV_CUSTOMER_EMAIL=
NEXT_PUBLIC_DEV_CUSTOMER_PASSWORD=
NEXT_PUBLIC_DEV_VENDOR_EMAIL=
NEXT_PUBLIC_DEV_VENDOR_PASSWORD=
NEXT_PUBLIC_DEV_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=
