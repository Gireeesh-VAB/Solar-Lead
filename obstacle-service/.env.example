# Copy to `.env` (next to this file) and fill in. `.env` is git-ignored. Real environment variables win over this file.

# Google Maps key with "Maps Static API" enabled. Needed to fetch the satellite view the models were trained on.
GOOGLE_MAPS_API_KEY=

# Folder of *.pt segmentation models (relative paths are relative to this folder). Default: weights
# OBSTACLE_MODEL_DIR=weights

# Tunables (defaults shown)
# OBSTACLE_MODEL_CONF=0.25
# OBSTACLE_IMGSZ=640
# OBSTACLE_MAX_DET=50
# OBSTACLE_MATCH_IOU=0.4
# OBSTACLE_MIN_SCORE=0.25
# OBSTACLE_MAX_ZOOM=19
# OBSTACLE_CROP_MARGIN=0.3
# OBSTACLE_ROOF_OVERLAP_MIN=0.3
# OBSTACLE_MIN_AREA_M2=0.25
# OBSTACLE_MAX_AREA_FRACTION=0.5
# OBSTACLE_DEVICE=cpu
